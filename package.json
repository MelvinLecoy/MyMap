{
  "name": "elsewhere-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/import-data.ts && vite --host 0.0.0.0",
    "data:import": "tsx scripts/import-data.ts",
    "city:prepare-data": "tsx scripts/prepare-city-history.ts",
    "city:prepare": "tsx scripts/prepare-city-database.ts",
    "city:verify-live": "NODE_USE_ENV_PROXY=1 tsx scripts/prepare-city-database.ts --dry-run",
    "city:apply": "NODE_USE_ENV_PROXY=1 tsx scripts/prepare-city-database.ts --apply",
    "city:prepare-corrections": "tsx scripts/prepare-city-corrections.ts",
    "city:verify-corrections": "NODE_USE_ENV_PROXY=1 tsx scripts/prepare-city-corrections.ts --dry-run",
    "city:apply-corrections": "NODE_USE_ENV_PROXY=1 tsx scripts/prepare-city-corrections.ts --apply",
    "history:prepare-updates": "tsx scripts/prepare-duration-updates.ts",
    "history:verify-updates": "NODE_USE_ENV_PROXY=1 tsx scripts/prepare-duration-updates.ts --dry-run",
    "history:apply-updates": "NODE_USE_ENV_PROXY=1 tsx scripts/prepare-duration-updates.ts --apply",
    "country:prepare": "tsx scripts/prepare-country-database.ts",
    "country:verify-live": "NODE_USE_ENV_PROXY=1 tsx scripts/prepare-country-database.ts --dry-run",
    "country:apply": "NODE_USE_ENV_PROXY=1 tsx scripts/prepare-country-database.ts --apply",
    "data:resolve-coordinates": "tsx scripts/resolve-coordinates.ts",
    "atlas:prepare": "tsx scripts/prepare-atlas.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:cloud": "ATLAS_CLOUD_TEST=1 playwright test",
    "supabase:provision": "NODE_USE_ENV_PROXY=1 tsx scripts/provision-cloud.ts",
    "build": "tsx scripts/import-data.ts && tsc --noEmit && vite build",
    "build:demo": "tsx scripts/import-data.ts --demo && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src scripts tests *.ts *.json *.md *.html",
    "fonts:prepare": "tsx scripts/prepare-fonts.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "0.468.0",
    "maplibre-gl": "5.12.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@maplibre/maplibre-gl-style-spec": "24.10.0",
    "@playwright/test": "1.56.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "csv-parse": "6.1.0",
    "i18n-iso-countries": "7.14.0",
    "mapshaper": "0.6.113",
    "pbf": "4.0.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
