# Optional compatible MapLibre style. Atlas-only layer selection still applies.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Optional database-backed collection. Set both or leave both unset.
# Use only a publishable key (or legacy anon key). Never use a secret/service-role key.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
